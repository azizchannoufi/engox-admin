# Mock mode is ON by default. Set to "false" when the NestJS API is ready.
VITE_USE_MOCK=true

# NestJS API (Back-End listens on PORT, default 3000)
VITE_API_BASE_URL=http://localhost:3000

# Socket.IO GPS gateway namespace from gps-tracking.gateway.ts
VITE_GPS_WS_URL=http://localhost:3000/gps-tracking
